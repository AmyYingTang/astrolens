#!/usr/bin/env bash
#
# astrolens 便捷运行脚本
#
#   ./quickastrolens                             打开 studio(首页:新读图 / 打开已有)
#   ./quickastrolens setup                       安装依赖并构建所有包(首次使用)
#   ./quickastrolens build                       重新构建
#   ./quickastrolens read <图片> [对象名] [语言]   读图 + 渲染,一步到位
#   ./quickastrolens render <report.json> [格式]  渲染 annotated|embed|poster|all
#   ./quickastrolens edit <report.json> [端口]    打开本地编辑器,浏览器里微调圈和文字
#   ./quickastrolens help                        显示帮助
#
# 示例:
#   ./quickastrolens setup
#   ./quickastrolens read testimage/SH2-308.jpg "Sh2-308"
#   ./quickastrolens edit out/SH2-308/report.json
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI="$ROOT/packages/cli/dist/index.js"

cd "$ROOT"

ensure_pnpm() {
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "==> 启用 pnpm (corepack)"
    corepack enable pnpm
  fi
}

ensure_built() {
  if [ ! -f "$CLI" ]; then
    echo "==> 未发现构建产物,先构建"
    ensure_pnpm
    pnpm build
  fi
}

usage() {
  sed -n '3,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

cmd="${1:-studio}"
case "$cmd" in
  studio)
    ensure_built
    node "$CLI" studio
    ;;

  setup)
    ensure_pnpm
    echo "==> pnpm install"
    pnpm install
    echo "==> pnpm build"
    pnpm build
    echo "==> 完成。试试: ./quickastrolens read testimage/SH2-308.jpg \"Sh2-308\""
    ;;

  build)
    ensure_pnpm
    pnpm build
    ;;

  read)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens read <图片> [对象名] [语言 zh|en]" >&2
      exit 1
    fi
    ensure_built
    image="$1"
    hint="${2:-}"
    lang="${3:-zh}"
    base="$(basename "$image")"
    name="${base%.*}"
    out="$ROOT/out/$name"

    args=(read "$image" --out "$out" --lang "$lang")
    if [ -n "$hint" ]; then
      args+=(--hint "$hint")
    fi

    echo "==> 读图: $image -> $out/report.json"
    node "$CLI" "${args[@]}"
    echo "==> 渲染标注图"
    node "$CLI" render "$out/report.json"
    echo "==> 完成: $out/annotated.jpg"
    ;;

  render)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens render <report.json> [格式 annotated|embed|poster|all]" >&2
      exit 1
    fi
    ensure_built
    report="$1"
    fmt="${2:-annotated}"
    node "$CLI" render "$report" --format "$fmt"
    ;;

  edit)
    shift
    if [ $# -lt 1 ]; then
      echo "用法: ./quickastrolens edit <report.json> [端口]" >&2
      exit 1
    fi
    ensure_built
    report="$1"
    if [ $# -ge 2 ]; then
      node "$CLI" edit "$report" --port "$2"
    else
      node "$CLI" edit "$report"
    fi
    ;;

  help | -h | --help)
    usage
    ;;

  *)
    echo "未知命令: $cmd" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
